.pybuilder/
target/

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
#   For a library or package, you might want to share your .python-version.
#   For an app, this is usually fine to prevent over-writing.
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if you are prevent platform-specific dependency issues:
#   Pipfile.lock

# poetry
#   Similar to Pipfile.lock, it is generally recommended to include poetry.lock in version control.
#   poetry.lock

# pdm
#   Similar to Pipfile.lock, it is generally recommended to include pdm.lock in version control.
#   pdm.lock

# virtualenv
#   Common names for Python virtual environments
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# Environment variables and secrets (CRUCIAL FOR SECURITY)
.env
.env.*
!.env.example
secrets.json
*.pem
*.key

# IDEs / Editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*~

# Operating System Files
.DS_Store
Thumbs.db

# Saída gerada pelas execuções do pipeline (--salvar)
saida/
